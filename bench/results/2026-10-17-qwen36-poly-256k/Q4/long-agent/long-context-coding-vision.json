      "source": "def merge_tool_results(calls, results):\n    \"\"\"Merge tool calls with their results.\n\n    Args:\n        calls: list of call dicts (each must have 'id')\n        results: list of result dicts (each must have 'id')\n\n    Returns:\n        list of dicts in call order: {'id': id, 'status': 'done', 'content': content}\n        or {'id': id, 'status': 'pending'} if no result exists.\n\n    Raises:\n        ValueError: if duplicate call ids are found.\n    \"\"\"\n    # Check for duplicate call ids\n    call_ids = []\n    for call in calls:\n        call_id = call.get('id')\n        if call_id in call_ids:\n            raise ValueError(f\"Duplicate call id: {call_id}\")\n        call_ids.append(call_id)\n\n    # Build a map of result_id -> result for quick lookup\n    # The last result for an id wins\n    result_map = {}\n    for result in results:\n        result_id = result.get('id')\n        result_map[result_id] = result\n\n    # Build the merged results in call order\n    merged = []\n    for call in calls:\n        call_id = call.get('id')\n        if call_id in result_map:\n            result = result_map[call_id]\n            content = result.get('content', '')\n            merged.append({\n                'id': call_id,\n                'status': 'done',\n                'content': content\n            })\n        else:\n            merged.append({\n                'id': call_id,\n                'status': 'pending'\n            })\n\n    return merged\n",
