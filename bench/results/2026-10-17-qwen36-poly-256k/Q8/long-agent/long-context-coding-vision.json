      "source": "def merge_tool_results(calls, results):\n    # Check for duplicate call ids\n    call_ids = []\n    for call in calls:\n        cid = call['id']\n        if cid in call_ids:\n            raise ValueError(f\"Duplicate call id: {cid}\")\n        call_ids.append(cid)\n    \n    # Build a dict of results by id (last one wins)\n    results_by_id = {}\n    for result in results:\n        rid = result['id']\n        results_by_id[rid] = result\n    \n    # Build the output in call order\n    output = []\n    for call in calls:\n        cid = call['id']\n        if cid in results_by_id:\n            result = results_by_id[cid]\n            content = result.get('content', '')\n            output.append({'id': cid, 'status': 'done', 'content': content})\n        else:\n            output.append({'id': cid, 'status': 'pending'})\n    \n    return output\n",
