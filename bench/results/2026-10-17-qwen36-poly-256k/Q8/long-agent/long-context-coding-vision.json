      "source": "def trim_history(messages, budget):\n    if not isinstance(budget, (int, float)) or budget < 0:\n        raise ValueError(\"budget must be nonnegative\")\n    for m in messages:\n        if not isinstance(m.get(\"cost\"), int) or m[\"cost\"] < 0:\n            raise ValueError(\"every message cost must be nonnegative\")\n    total = sum(m[\"cost\"] for m in messages)\n    if total <= budget:\n        return list(messages)\n    suffix_start = len(messages)\n    running = 0\n    for i in range(len(messages) - 1, -1, -1):\n        running += messages[i][\"cost\"]\n        if running <= budget:\n            suffix_start = i\n        else:\n            break\n    return list(messages[suffix_start:])\n",
